<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Neural Ring -->
    <path
        android:strokeWidth="1.8"
        android:strokeColor="#3300E5FF"
        android:fillColor="#00000000"
        android:pathData="M 54,26 A 28,28 0 1,1 53.9,26 Z" />

    <!-- Corner Accents / Neural Tensor Nodes -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M 54,23 A 2.5,2.5 0 1,1 53.9,23 Z" />
    <path
        android:fillColor="#00E676"
        android:pathData="M 82,54 A 2.5,2.5 0 1,1 81.9,54 Z" />
    <path
        android:fillColor="#00E5FF"
        android:pathData="M 54,85 A 2.5,2.5 0 1,1 53.9,85 Z" />
    <path
        android:fillColor="#00E676"
        android:pathData="M 26,54 A 2.5,2.5 0 1,1 25.9,54 Z" />

    <!-- ZORO Hexagonal Neural Core Shield -->
    <path
        android:pathData="M 54,30 L 76,43 L 76,65 L 54,78 L 32,65 L 32,43 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#5500E5FF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:offset="0.0" android:color="#3300E5FF" />
                <item android:offset="1.0" android:color="#1A00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bold Stylized 'Z' Core Blade -->
    <path
        android:pathData="M 37,38 L 71,38 L 71,44 L 48.5,64 L 71,64 L 71,70 L 37,70 L 37,64 L 59.5,44 L 37,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="38"
                android:endX="71"
                android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.4" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#00E676" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neural Synapse Cross Spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,52 L 55.5,54 L 54,56 L 52.5,54 Z" />
</vector>
